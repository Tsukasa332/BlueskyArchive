POSTGRES_DB=bluesky_archive
POSTGRES_USER=bluesky
POSTGRES_PASSWORD=change_me
BACKEND_DB_USER=bluesky_backend
BACKEND_DB_PASSWORD=change_me_backend
FETCHER_DB_USER=bluesky_fetcher
FETCHER_DB_PASSWORD=change_me_fetcher

BLSKY_IDENTIFIER=your-handle.bsky.social
BLSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

APP_TIMEZONE=Asia/Tokyo
# true stores only directly attached media and video captions created by the archived account.
# false stores no image, video, or caption files.
SAVE_OWN_MEDIA=false
MEDIA_ROOT=/app/media
MEDIA_MIN_FREE_BYTES=5368709120
MEDIA_MAX_FILE_BYTES=157286400
MEDIA_MAX_TOTAL_BYTES=53687091200
MEDIA_TOTAL_SCAN_INTERVAL_SECONDS=300
FETCH_INTERVAL_SECONDS=900
FETCH_PAGE_LIMIT=100
FULL_RECONCILE_INTERVAL_SECONDS=86400
ERROR_BACKOFF_SECONDS=60
HTTP_PORT=8080
